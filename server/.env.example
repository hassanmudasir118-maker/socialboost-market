# Copy to server/.env and fill with real values from your hosting/payment provider.
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://your-frontend.example
APP_URL=https://your-frontend.example
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m

# Required in every environment — the runtime only supports PostgreSQL (postgres:// or postgresql://).
# Managed providers (RDS, Supabase, Render, Neon, etc.) usually require TLS:
#   PGSSL=require       — encrypted, no certificate verification (common managed-provider default)
#   PGSSL=verify-full    — full certificate verification (also set PGSSLROOTCERT if needed)
#   PGSSL=disable        — local/no-TLS Postgres only
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
PGSSL=require

# stripeProvider.js is implemented — set PAYMENT_PROVIDER=stripe and fill in
# real Stripe keys below (PAYMENT_PUBLIC_KEY = pk_live_/pk_test_..., PAYMENT_SECRET_KEY = sk_live_/sk_test_...,
# PAYMENT_WEBHOOK_SECRET = whsec_... from your webhook endpoint's settings).
# Note: real creator PAYOUTS additionally require each creator to complete
# Stripe Connect onboarding (see migrations/0003_stripe_connect.sql and
# stripeProvider.js's createPayout comments) — that onboarding flow itself
# is not yet built; payment funding/refunds work without it.
PAYMENT_PROVIDER=
PAYMENT_TEST_MODE=false
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=usd

# Manual (human-confirmed) payment methods — shown to advertisers as the
# platform's own receiving account; they send money themselves and submit a
# reference, which an admin confirms before escrow is funded (see
# PRODUCTION_READINESS.md). Leave a method's vars blank to hide it from
# checkout entirely. These are account numbers meant to be shown to
# advertisers, not secrets — but still don't commit a real .env file.
PLATFORM_EASYPAISA_NAME=
PLATFORM_EASYPAISA_NUMBER=
PLATFORM_JAZZCASH_NAME=
PLATFORM_JAZZCASH_NUMBER=
PLATFORM_BANK_ACCOUNT_NAME=
PLATFORM_BANK_ACCOUNT_NUMBER=
PLATFORM_BANK_NAME=

# Social account OAuth — see server/src/services/socialProviders/ for what
# each adapter does with these. Leave a platform's vars blank to leave that
# platform's "Connect" button showing a configuration error rather than a
# fake connection (see §15 of the OAuth architecture brief).
SOCIAL_TOKEN_ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_-base64_32
FRONTEND_URL=https://your-frontend.example

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://your-api.example/api/social-accounts/YOUTUBE/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-api.example/api/social-accounts/TIKTOK/callback

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-api.example/api/social-accounts/INSTAGRAM/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://your-api.example/api/social-accounts/FACEBOOK/callback
