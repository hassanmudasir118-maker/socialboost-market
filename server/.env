DATABASE_URL="postgres://socialboost:socialboost@localhost:5432/socialboost_dev"
# PGSSL=disable|require|verify-full — leave unset for a local, no-TLS Postgres like the one above.
PGSSL=disable
JWT_SECRET="dev-only-change-me-in-production-8f3a9c2e1b7d4f60"
JWT_EXPIRES_IN="15m"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"
NODE_ENV=development

# Payment provider — placeholders only. Never commit real secret keys.
# To go live: set PAYMENT_PROVIDER to a real adapter name (see
# src/services/paymentProvider/index.js), and fill these from your provider
# dashboard via a real secrets manager, not this file.
PAYMENT_PROVIDER="mock"
PAYMENT_TEST_MODE="true"
PAYMENT_PUBLIC_KEY="pk_test_placeholder"
PAYMENT_SECRET_KEY="sk_test_placeholder_never_send_to_frontend"
PAYMENT_WEBHOOK_SECRET="whsec_test_placeholder_dev_only_8f2a9c"
PAYMENT_CURRENCY="usd"

# Social account OAuth (platform developer credentials — leave blank in dev;
# any "Connect" button for an unconfigured platform shows a clear
# configuration error instead of pretending to connect, see §15).
SOCIAL_TOKEN_ENCRYPTION_KEY="LCBk7ysAYtSPMvLtOzc7YNgFvdbfonK9YKRE5zcYEWE="
